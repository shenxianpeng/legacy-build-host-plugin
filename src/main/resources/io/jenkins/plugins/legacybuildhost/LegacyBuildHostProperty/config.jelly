<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Legacy host}" field="host">
    <f:textbox checkMethod="post"/>
  </f:entry>
  <f:entry title="${%SSH port}" field="port">
    <f:number default="22" min="1" max="65535"/>
  </f:entry>
  <f:entry title="${%Credentials}" field="credentialsId">
    <c:select checkMethod="post"/>
  </f:entry>
  <f:advanced>
    <f:entry title="${%Extra ssh options}" field="sshOptions">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Commands that stay on this agent}" field="localCommands">
      <f:textbox default="git"/>
    </f:entry>
  </f:advanced>
</j:jelly>
